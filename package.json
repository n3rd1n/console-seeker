{
	"name": "console-seeker",
	"version": "1.0.0",
	"description": "A tool to find log statements (like console.log) in JavaScript/TypeScript projects",
	"main": "dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**/*",
		"README.md"
	],
	"bin": {
		"console-seeker": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/index.js",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"unused-console-log-statements",
		"console-log",
		"console",
		"log",
		"dead-code",
		"cleanup",
		"javascript",
		"typescript",
		"analysis"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n3rd1n/log-seeker.git"
	},
	"bugs": {
		"url": "https://github.com/n3rd1n/log-seeker/issues"
	},
	"homepage": "https://github.com/n3rd1n/log-seeker#readme",
	"author": "n3rd1n",
	"license": "MIT"
}
