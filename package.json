{
	"name": "console-seeker",
	"version": "1.1.0",
	"description": "Find console statements in JavaScript/TypeScript projects",
	"main": "dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**/*",
		"LICENSE",
		"README.md"
	],
	"bin": {
		"console-seeker": "dist/cli.js"
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"start": "node dist/cli.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"prepublishOnly": "npm test && npm run build"
	},
	"keywords": [
		"console.log",
		"console",
		"log",
		"dead-code",
		"cleanup",
		"javascript",
		"typescript",
		"analysis",
		"ci"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n3rd1n/console-seeker.git"
	},
	"bugs": {
		"url": "https://github.com/n3rd1n/console-seeker/issues"
	},
	"homepage": "https://github.com/n3rd1n/console-seeker#readme",
	"author": "n3rd1n",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"commander": "^14.0.1"
	},
	"devDependencies": {
		"@types/node": "^24.7.0",
		"prettier": "^3.6.2",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	}
}
